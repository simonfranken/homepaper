# Main task and pthread stack sizes (TLS + JSON)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096

# 4 MB flash; partition layout lives in partitions.csv and is applied by espflash
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# TLS for wss:// server URLs
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y

# Setup portal: allow the HTTP server to accept a full form POST
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
