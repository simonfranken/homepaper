# Copy to .env (gitignored) and fill in. The server reads .env from its
# working directory on start; real environment variables take precedence.
# See the README's server section and docs/decisions.md (D-016).

# Home Assistant base URL, e.g. http://homeassistant.local:8123 or https://ha.example.com
HA_URL=

# Long-lived access token of a dedicated, non-admin HA user for homepaper:
# log in to HA as that user → profile → Security → Long-lived access tokens
HA_TOKEN=

# Optional
# HA_PUBLIC_URL=            # HA as the browser reaches it, if different from HA_URL
# HOMEPAPER_URL=            # homepaper as the browser reaches it, e.g. https://homepaper.example.org
# HOMEPAPER_LOGIN=admins    # or users
# HOMEPAPER_AUTH=on         # off: no login (development and demo only)
# HOMEPAPER_LISTEN=:8080
# HOMEPAPER_DATA=data
# HOMEPAPER_MIN_INTERVAL=3s
# HOMEPAPER_FULL_REFRESH_EVERY=20
# TZ=Europe/Berlin
